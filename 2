import turtle
# --- Настройки экрана ---
t = turtle.Turtle()
t.speed(0)
t.hideturtle()
screen = turtle.Screen()
screen.bgcolor("lightblue")
screen.setup(width=800, height=700)

# =====================================================
# ПАРА 1 — СОЛНЫШКО
# =====================================================

t.color("orange")
t.width(6)
for i in range(16):
    t.penup()
    t.goto(300, 250)
    t.pendown()
    t.setheading(i * 22.5)
    t.forward(90)
t.width(1)
t.penup()
t.goto(280, 195)
t.pendown()
t.color("yellow")
t.begin_fill()
t.circle(60)
t.end_fill()

# =====================================================
# ПАРА 2 — ОБЛАКА
# =====================================================

# ПЕРВОЕ
t.color("white")
coords = [
    (100, 280, 40),
    (70, 290, 30),
    (130, 290, 30),
    (50, 270, 25),
    (150, 270, 25),
    (100, 260, 35)
]
for a, b, r in coords:
    t.penup()
    t.goto(a, b - r)
    t.pendown()
    t.begin_fill()
    t.circle(r)
    t.end_fill()

# ВТОРОЕ
coords1 = [
    (-100, 280, 40),
    (-130, 290, 30),
    (-70, 290, 30),
    (-150, 270, 25),
    (-50, 270, 25),
    (-100, 260, 35)
]
for a, b, r in coords1:
    t.penup()
    t.goto(a, b - r)
    t.pendown()
    t.begin_fill()
    t.circle(r)
    t.end_fill()

# ТРЕТЬЕ
coords2 = [
    (-300, 270, 35),
    (-330, 280, 25),
    (-270, 280, 25),
    (-350, 260, 20),
    (-250, 260, 20),
    (-300, 250, 30)
]
for a, b, r in coords2:
    t.penup()
    t.goto(a, b - r)
    t.pendown()
    t.begin_fill()
    t.circle(r)
    t.end_fill()

# =====================================================
# ПАРА 3 — ЦВЕТЫ
# =====================================================

# КРАСНЫЙ
t.color("darkgreen")
t.width(4)
t.penup()
t.goto(-200, -300)
t.pendown()
t.setheading(90)
t.forward(120)
t.width(1)
t.color("red")
for i in range(8):
    t.penup()
    t.goto(-200, -180)
    t.pendown()
    t.setheading(i * 45)
    t.begin_fill()
    t.circle(30, 180)
    t.circle(30, 180)
    t.end_fill()
t.penup()
t.goto(-215, -190)
t.pendown()
t.color("orange")
t.begin_fill()
t.circle(20)
t.end_fill()

# ЖЁЛТЫЙ
t.color("darkgreen")
t.width(4)
t.penup()
t.goto(0, -300)
t.pendown()
t.setheading(90)
t.forward(120)
t.width(1)
t.color("yellow")
for i in range(8):
    t.penup()
    t.goto(0, -180)
    t.pendown()
    t.setheading(i * 45)
    t.begin_fill()
    t.circle(30, 180)
    t.circle(30, 180)
    t.end_fill()
t.penup()
t.goto(-15, -190)
t.pendown()
t.color("orange")
t.begin_fill()
t.circle(20)
t.end_fill()

# СИНИЙ
t.color("darkgreen")
t.width(4)
t.penup()
t.goto(200, -300)
t.pendown()
t.setheading(90)
t.forward(120)
t.width(1)
t.color("blue")
for i in range(8):
    t.penup()
    t.goto(200, -180)
    t.pendown()
    t.setheading(i * 45)
    t.begin_fill()
    t.circle(30, 180)
    t.circle(30, 180)
    t.end_fill()
t.penup()
t.goto(185, -190)
t.pendown()
t.color("orange")
t.begin_fill()
t.circle(20)
t.end_fill()

# =====================================================
# ПАРА 4 — СЕРДЕЧКИ
# =====================================================

# ПЕРВОЕ
t.penup()
t.goto(-300, 50)
t.pendown()
t.color("red")
t.begin_fill()
t.setheading(140)
t.forward(62)
t.circle(-35, 200)
t.setheading(60)
t.circle(-35, 200)
t.forward(62)
t.end_fill()

# ВТОРОЕ
t.penup()
t.goto(300, 0)
t.pendown()
t.color("red")
t.begin_fill()
t.setheading(140)
t.forward(62)
t.circle(-35, 200)
t.setheading(60)
t.circle(-35, 200)
t.forward(62)
t.end_fill()

# НАДПИСЬ
t.penup()
t.goto(0, 70)
t.pendown()
t.color("purple")
t.write("С 8 Марта!", align="center", font=("Arial", 35, "normal"))
t.penup()
t.goto(0, 30)
t.pendown()
t.color("black")
t.write("Дорогие женщины!", align="center", font=("Arial", 25, "normal"))
t.penup()
t.goto(0, 0)
t.pendown()
t.color("blue")
t.write("Пусть каждый день будет ярким!", align="center", font=("Arial", 15, "normal"))

# =====================================================
# ПАРА 5 — ТРАВА
# =====================================================

t.color("green")
for i in range(24):
    t.penup()
    t.goto(-300 + i * 25, -300)
    t.pendown()
    d = 1 if i % 2 == 0 else -1
    t.setheading(75 + (i % 5) * 10)
    t.width(3 - (i % 2))
    n = 70 + (i % 30)
    for j in range(int(n / 10)):
        t.forward(10)
        t.left(5 * d)
    t.width(1)

turtle.done()
